# ── Service Ports ─────────────────────────────────────────────
AUTH_SERVICE_PORT=8080
SIMULATION_SERVICE_PORT=8081
REGULATION_SERVICE_PORT=8082

# ── Database (각 서비스 전용 DB) ──────────────────────────────
# docker-compose.yml의 단일 MySQL에 서비스별 DB 3개(hwalro_auth/simulation/regulation)가 생성됨
# 각 서비스는 자기 DB에만 접속한다 (GRANT로 접근 권한 부여됨)
DB_URL=jdbc:mysql://localhost:3307/hwalro_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hwalro
DB_PASSWORD=hwalro

# MySQL 컨테이너 초기화 값 (docker-compose.yml에서 사용)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hwalro_auth
MYSQL_USER=hwalro
MYSQL_PASSWORD=hwalro
MYSQL_PORT=3307

# 스키마 자동 초기화 (auth-service). 개발에서만 always 사용 (CREATE IF NOT EXISTS)
DB_INIT_MODE=never

# ── Redis (auth-service) ──────────────────────────────────────
# Refresh Token(RTR) 저장소. docker-compose.yml 기준 6380 포트 매핑
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TIMEOUT=3s

# ── JWT (auth-service) ────────────────────────────────────────
# 운영 환경에서는 반드시 임의의 긴 문자열로 교체할 것 (HS256 서명 키, 32바이트 이상)
JWT_SECRET=dev-only-secret-key-change-me-in-production-0123456789abcdef
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_ISSUER=hwalro-auth-service

# ── Cookie (auth-service) ─────────────────────────────────────
# 운영(HTTPS) 환경에서는 Secure=true, SameSite=Strict 권장
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false

# ── CORS (auth-service) ───────────────────────────────────────
# 프론트엔드 개발 서버 주소 (쉼표로 여러 개 지정 가능)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Spring AI (simulation-service, regulation-service) ────────
# Spring AI 사용 시 (application.yml의 exclude 제거) 아래 값 사용
OPENAI_API_KEY=
