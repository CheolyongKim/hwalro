<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hwalro.auth.mapper.UserMapper">

    <select id="findByLoginId" resultType="com.hwalro.auth.domain.User">
        SELECT id,
               login_id,
               password,
               name,
               role,
               created_at,
               updated_at
        FROM users
        WHERE login_id = #{loginId}
    </select>

</mapper>
