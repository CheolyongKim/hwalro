{
  "name": "hwalro",
  "private": true,
  "scripts": {
    "dev": "turbo dev --ui tui",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infra": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:migrate:auth-roles": "./scripts/migrate-auth-roles.sh"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.4.4",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
